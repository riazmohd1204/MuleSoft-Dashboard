# Environment Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database Configuration (example)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mule_projects
DB_USER=mule_user
DB_PASSWORD=your-db-password-here

# Security
SESSION_SECRET=your-secret-key-here
JWT_SECRET=your-jwt-secret-here

# External Services (example)
EXTERNAL_API_URL=https://api.example.com
EXTERNAL_API_KEY=your-api-key-here

# Mule Runtime Configuration
MULE_RUNTIME_VERSION=4.9.x
MULE_HOME=/opt/mule

# Analysis Settings
MAX_FILE_SIZE=10485760
MAX_PROJECT_FILES=1000
ANALYSIS_TIMEOUT=300000

# Chat Settings
MAX_CONVERSATION_HISTORY=100
SESSION_TIMEOUT=1800000

# WebSocket Settings
WS_HEARTBEAT_INTERVAL=25000
WS_HEARTBEAT_TIMEOUT=5000

# GitHub Integration (required for GitHub-based code review)
GITHUB_TOKEN=ghp_your-personal-access-token-here
GITHUB_ORG=LS-CO
GITHUB_API_URL=https://api.github.com
GITHUB_REPO_PREFIX=

# MUnit Coverage Server — Jenkins Console Log Parser
# Fetches "Application Coverage: XX%" from Jenkins build console output
MUNIT_COVERAGE_URL=http://your-jenkins-server:8080
MUNIT_COVERAGE_USERNAME=your-jenkins-username
MUNIT_COVERAGE_PASSWORD=your-jenkins-password
MUNIT_COVERAGE_ENV=dev
MUNIT_COVERAGE_TIMEOUT=30000

# Jenkins folder hierarchy settings
JENKINS_TOP_FOLDER=C4E-Development
JENKINS_LAYERS=Experience,Process,System,Framework,Utilities
JENKINS_JOB_SUFFIX=-rtf-dev
REPO_PREFIX=leviC4E-

# Teams Webhook URLs
TEAMS_WEBHOOK_URL=https://your-teams-webhook-url-here
TEAMS_ALERTS_WEBHOOK_URL=https://your-teams-alerts-webhook-url-here

# Anypoint Exchange / Design Center Connected App
ANYPOINT_CLIENT_ID=your-anypoint-client-id
ANYPOINT_CLIENT_SECRET=your-anypoint-client-secret
ANYPOINT_EXCHANGE_CLIENT_ID=your-anypoint-client-id
ANYPOINT_EXCHANGE_CLIENT_SECRET=your-anypoint-client-secret
ANYPOINT_DESIGN_CENTER_CLIENT_ID=your-anypoint-client-id
ANYPOINT_DESIGN_CENTER_CLIENT_SECRET=your-anypoint-client-secret
ANYPOINT_ORG_ID=your-anypoint-org-id

# SSL (set to 0 only for corporate proxy environments)
# NODE_TLS_REJECT_UNAUTHORIZED=0